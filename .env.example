# AI Agent Board environment variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Bind locally by default. Override only for an intentional trusted deployment.
HOST=127.0.0.1

# Vite Host-header allowlist. Add a trusted reverse-proxy hostname when needed.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Server-side Host allowlist for WebSocket upgrades.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Set DATABASE_URL to use PostgreSQL. Leave empty/unset to use SQLite (default).
# DATABASE_URL=postgresql://agentboard:your_password@localhost:5433/agentboard

# --- Authentication ---
# Legacy full-access browser/API token.
# API_KEY=replace-me
# Scoped integration credentials (JSON). Store either token or sha256; prefer sha256.
# Allowed scopes: projects:read, agents:read, orchestrations:create, orchestrations:read, orchestrations:message
# SERVICE_TOKENS=[{"sha256":"<sha256-of-token>","scopes":["projects:read","agents:read","orchestrations:create","orchestrations:read","orchestrations:message"]}]
# Public origin used to generate direct task links returned by the orchestration API.
# AGENT_BOARD_PUBLIC_URL=https://kanban.example.com
# Set API_KEY to require Bearer token auth on all API and WebSocket requests.
# Leave unset for open access (local dev). Must match VITE_API_KEY on the client.
# API_KEY=your-secret-key

# --- Agent models (optional overrides) ---
# COPILOT_MODEL=claude-opus-4-20250514
# CLAUDE_MODEL=claude-opus-4-20250514
# CODEX_MODEL=gpt-5.2-codex
