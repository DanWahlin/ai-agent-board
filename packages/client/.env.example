# Client environment variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Bind locally and reject untrusted Host headers by default.
HOST=127.0.0.1
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Authentication ---
# Set VITE_API_KEY to match the server's API_KEY.
# Leave unset for open access (local dev).
# VITE_API_KEY=your-secret-key
